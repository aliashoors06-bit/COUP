# Port the Node server listens on (production serves the built client too)
PORT=3001
# Set to "production" to serve the built client from dist/
NODE_ENV=development
# Optional: comma-separated list of allowed origins if the client is hosted on another domain
CLIENT_ORIGIN=
# Dev only: where the Vite dev server proxies Socket.IO traffic
VITE_API_TARGET=http://localhost:3001
# Optional: connect the client to a different server origin (leave empty for same-origin)
VITE_SERVER_URL=
